# Research Intelligence Platform — environment configuration
# Copy to .env and fill in what you need. Everything is optional:
# the platform runs fully offline with LLM_PROVIDER=mock.

# LLM provider: mock | anthropic | openai
LLM_PROVIDER=mock
# Model id for the chosen provider (e.g. claude-sonnet-5, gpt-4o)
LLM_MODEL=
# Sampling temperature for provider calls (0 = deterministic extraction)
LLM_TEMPERATURE=0

# Provider keys (never commit real values)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (vLLM, Ollama, OpenRouter, ...)
OPENAI_BASE_URL=https://api.openai.com/v1

# Collector credentials / politeness settings
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex asks for a contact email to get the polite pool
OPENALEX_MAILTO=

# Storage locations (relative to the working directory by default)
DATA_DIR=data
EXPORTS_DIR=exports
REPORTS_DIR=reports

# HTTP behaviour
HTTP_TIMEOUT=30
HTTP_RETRIES=3
